# Installed by limde as /etc/apparmor.d/limde-firefox.
# Lets Mozilla's Firefox build in ~/.local/opt/firefox use its process sandbox, which
# needs unprivileged user namespaces (restricted by default on Ubuntu). This is the same
# permission Ubuntu's own Firefox profile grants.
abi <abi/4.0>,
include <tunables/global>

profile limde-firefox @{HOME}/.local/opt/firefox/{firefox,firefox-bin,updater} flags=(unconfined) {
    userns,

    include if exists <local/limde-firefox>
}
