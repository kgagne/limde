#!/usr/bin/env python3
"""Render limde's appearance into the config files of each desktop program.

Reads the shipped defaults (appearance.toml beside the templates) and, on top of them,
your own ~/.config/limde/appearance.toml, which only needs the keys you change. Then
renders the templates listed in manifest.toml into your home folder.

    limde-appearance              show what would change (a diff)
    limde-appearance --check      exit 1 if anything is out of date
    limde-appearance --apply      write the changes, backing up what they replace
    limde-appearance --apply --mode light   switch to light or dark and keep it (Tinybar's
                                  menu does this); the choice wins over mode in your file
    limde-appearance --output-dir DIR   render into DIR instead, for a preview

Standard library only.
"""
import argparse
import difflib
import json
import os
import re
import shutil
import subprocess
import tempfile
import tomllib
from datetime import datetime
from pathlib import Path
from string import Template

HERE = Path(__file__).resolve().parent
# Installed layout: bin/limde-appearance and share/limde/appearance/; in the
# repository the data sits beside this script.
DEFAULTS = next((d for d in (HERE.parent / 'share/limde/appearance', HERE)
                 if (d / 'appearance.toml').is_file()), HERE)
USER_FILE = Path.home() / '.config/limde/appearance.toml'
STATE = Path.home() / '.local/state/limde/appearance'
MODE_FILE = STATE / 'mode'

COLOR = re.compile(r'#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?')
NAME = re.compile(r'[A-Za-z0-9 _-]+')
FONT = re.compile(r'[A-Za-z][A-Za-z0-9 ]* [0-9]{1,2}')
INTERFACE = 'org.gnome.desktop.interface'


def merged_config(defaults_dir, user_file):
    config = tomllib.loads((defaults_dir / 'appearance.toml').read_text())
    if user_file.is_file():
        for group, entries in tomllib.loads(user_file.read_text()).items():
            if group not in config or not isinstance(entries, dict):
                raise ValueError(f'{user_file}: unknown group [{group}]')
            for key, value in entries.items():
                if (group, key) == ('desktop', 'color_scheme'):
                    continue  # replaced by desktop.mode; older files may still set it
                if key not in config[group]:
                    raise ValueError(f'{user_file}: unknown setting {group}.{key}')
                config[group][key] = value
    return config


def icon_theme(config):
    theme = config['icons']['theme']
    return theme if config['desktop']['mode'] == 'dark' else theme + '-light'


def template_values(config):
    values = {}
    for group, entries in config.items():
        for key, value in entries.items():
            if group in ('colors', 'colors_light'):
                ok = isinstance(value, str) and COLOR.fullmatch(value)
            elif group == 'shape':
                ok = type(value) is int and 0 <= value <= 64
            elif group == 'icons':
                if key == 'theme':
                    ok = isinstance(value, str) and NAME.fullmatch(value) and ' ' not in value
                elif key == 'selected_brightness':
                    ok = type(value) in (int, float) and 0.3 <= value <= 1
                else:
                    ok = type(value) is int and 8 <= value <= 128
            elif group == 'desktop':
                ok = (isinstance(value, str) and NAME.fullmatch(value)) if key == 'gtk_theme' \
                    else value in ('dark', 'light')
            elif group == 'fonts':
                ok = isinstance(value, str) and FONT.fullmatch(value)
            else:
                raise ValueError(f'unknown appearance group: {group}')
            if not ok:
                raise ValueError(f'invalid value for {group}.{key}: {value!r}')
            values[f'{group}_{key}'] = str(value)
    # The chosen mode's palette is what the templates see as colors_*.
    dark = config['desktop']['mode'] == 'dark'
    if not dark:
        for key, value in config['colors_light'].items():
            values[f'colors_{key}'] = value
    values['icons_theme'] = icon_theme(config)
    values['icons_selected_filter'] = f"brightness({config['icons']['selected_brightness']})" if dark else 'none'
    values['desktop_color_scheme'] = 'prefer-dark' if dark else 'prefer-light'
    values['desktop_prefer_dark'] = '1' if dark else '0'
    values['desktop_interface_scheme'] = 'dark' if dark else 'light'
    # The built-in base each GTK theme builds on; a dark base under the light
    # palette leaves its unstyled states (unfocused windows) dark.
    values['desktop_gtk3_base'] = 'gtk-contained-dark.css' if dark else 'gtk-contained.css'
    values['desktop_gtk4_base'] = 'Default-dark.css' if dark else 'Default-light.css'
    # Another theme's app icon, drawn edge to edge, is shrunk to limde's margin
    # (20.5 of 24 units) and centred in the same box.
    panel = config['icons']['panel_size']
    foreign = round(panel * 20.5 / 24)
    values['icons_panel_foreign_size'] = str(foreign)
    values['icons_panel_foreign_margin'] = str((panel - foreign) // 2)
    return values


def render(defaults_dir, values):
    manifest = tomllib.loads((defaults_dir / 'manifest.toml').read_text())
    rendered, seen = [], set()
    for entry in manifest['files']:
        relative, template = Path(entry['destination']), Path(entry['template'])
        if relative.is_absolute() or '..' in relative.parts or template.name != str(template):
            raise ValueError('manifest entries must be relative home paths and template names')
        if relative in seen:
            raise ValueError(f'duplicate destination: {relative}')
        seen.add(relative)
        content = Template((defaults_dir / 'templates' / template).read_text()).substitute(values)
        note = f'Generated by limde-appearance from templates/{template}; change ' \
               '~/.config/limde/appearance.toml, not this file.'
        header = f'/* {note} */\n' if relative.suffix == '.css' else f'# {note}\n'
        rendered.append((relative, header + content))
    return rendered


def desktop_preferences(config):
    """GNOME interface settings GTK apps read; skipped when gsettings is unavailable."""
    if not shutil.which('gsettings'):
        return {}
    wanted = {'icon-theme': icon_theme(config),
              'gtk-theme': config['desktop']['gtk_theme'],
              'color-scheme': 'prefer-dark' if config['desktop']['mode'] == 'dark' else 'prefer-light',
              'font-name': config['fonts']['interface'],
              'document-font-name': config['fonts']['document']}
    changes = {}
    for key, value in wanted.items():
        got = subprocess.run(['gsettings', 'get', INTERFACE, key], text=True, capture_output=True)
        if got.returncode != 0:
            return {}  # schemas not installed; the settings.ini files still apply
        if got.stdout.strip() != repr(value):
            changes[key] = {'before': got.stdout.strip(), 'after': value}
    return changes


def gsettings_said(stderr):
    """The last line gsettings printed, less GLib's log prefix
    ("(process:N): dconf-WARNING **: 19:29:37.999: ")."""
    lines = stderr.strip().splitlines()
    return re.sub(r'^.*?\d\d:\d\d:\d\d\.\d+: ', '', lines[-1]) if lines else ''


def set_desktop_preference(key, value):
    """Set one GNOME interface setting and read it back: gsettings set exits 0 even when
    the value is lost (without dconf it keeps it in memory, gone when it exits; dconf
    with no session bus only warns), so the error carries that warning."""
    done = subprocess.run(['gsettings', 'set', INTERFACE, key, value], text=True, capture_output=True)
    said = gsettings_said(done.stderr)
    if done.returncode != 0:
        raise ValueError(f'could not set desktop preference {key}: {said or "gsettings failed"}')
    got = subprocess.run(['gsettings', 'get', INTERFACE, key], text=True, capture_output=True)
    if got.returncode != 0 or got.stdout.strip() != repr(value):
        raise ValueError(f'desktop preference {key} did not persist: gsettings reads '
                         f'{got.stdout.strip() or "nothing"}, not {value!r}'
                         + (f' ({said})' if said else ''))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument('--apply', action='store_true')
    mode.add_argument('--check', action='store_true')
    mode.add_argument('--output-dir', type=Path)
    parser.add_argument('--mode', choices=('dark', 'light'),
                        help='with --apply: switch to dark or light and keep it')
    parser.add_argument('--defaults', type=Path, default=DEFAULTS, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.mode and not args.apply:
        parser.error('--mode needs --apply')

    config = merged_config(args.defaults, USER_FILE)
    # The switched mode is a runtime choice, kept apart from the file the user edits.
    saved_mode = MODE_FILE.read_text().strip() if MODE_FILE.is_file() else None
    wanted_mode = args.mode or saved_mode
    if wanted_mode in ('dark', 'light'):
        config['desktop']['mode'] = wanted_mode
    rendered = render(args.defaults, template_values(config))

    pending = []
    for relative, content in rendered:
        target = (args.output_dir or Path.home()) / relative
        old = target.read_text() if target.exists() else ''
        if old != content:
            pending.append((relative, target, old, content))

    if args.output_dir:
        for _, target, _, content in pending:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(content)
        print(f'Rendered {len(rendered)} files in {args.output_dir}')
        return

    prefs = desktop_preferences(config)
    if not args.apply:
        for _, target, old, content in pending:
            if args.check:
                print(f'Needs refresh: {target}')
            else:
                print(''.join(difflib.unified_diff(old.splitlines(True), content.splitlines(True),
                                                   fromfile=str(target), tofile=str(target))), end='')
        for key, change in prefs.items():
            print(f"Desktop preference needs refresh: {key} {change['before']} -> {change['after']}")
        if not pending and not prefs:
            print(f'All {len(rendered)} files and desktop preferences are current.')
        if args.check and (pending or prefs):
            raise SystemExit(1)
        return

    stamp = datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    backup = STATE / 'backups' / stamp
    for relative, target, _, _ in pending:
        if target.is_symlink():
            raise ValueError(f'review this symlink before replacing it: {target}')
        if target.exists():
            saved = backup / relative
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(target, saved)
    for _, target, _, content in pending:
        target.parent.mkdir(parents=True, exist_ok=True)
        mode = target.stat().st_mode & 0o777 if target.exists() else 0o644
        with tempfile.NamedTemporaryFile(mode='w', dir=target.parent, delete=False) as staged:
            staged.write(content)
        os.chmod(staged.name, mode)
        os.replace(staged.name, target)
        print(f'Updated: {target}')
    # Saved before the desktop preferences: should one of them fail, the mode file still
    # matches the files just written, and --check reports only that preference.
    if args.mode:
        MODE_FILE.parent.mkdir(parents=True, exist_ok=True)
        MODE_FILE.write_text(args.mode + '\n')
    if prefs:
        backup.mkdir(parents=True, exist_ok=True)
        (backup / 'desktop-preferences.before.json').write_text(json.dumps(prefs, indent=2) + '\n')
        for key, change in prefs.items():
            set_desktop_preference(key, change['after'])
            print(f"Updated desktop preference: {key} = {change['after']}")
    # The folder exists only if something was there to replace: new files and a home
    # without gsettings leave nothing to save.
    if backup.is_dir():
        print(f'Previous versions saved in {backup}')
    if pending or prefs:
        print('Reopen affected apps; run "makoctl reload" and "labwc --reconfigure" to refresh those.')
    else:
        print('Everything is already current.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        # OSError: an unreadable user file or a folder it cannot write to.
        raise SystemExit(f'limde-appearance: {error}')
