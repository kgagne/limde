From bb278071478842bcc7187762072bd4ef7d52176d Mon Sep 17 00:00:00 2001
From: Keith Gagne <kgagne@users.noreply.github.com>
Date: Wed, 4 Nov 2026 19:27:58 -0500
Subject: [PATCH] Add PCMANFM_GTK_THEME, a GTK theme for PCManFM alone

GTK_THEME would give PCManFM a theme of its own, but every program it
starts inherits the variable: the applications it opens files with, its
terminal, and everything run from that terminal. GTK 4 applications then
look for a GTK 4 version of the theme, and libadwaita ones drop their own
style sheet. PCMANFM_GTK_THEME names the theme instead, and PCManFM sets
it as its own gtk-theme-name, so it reaches nothing else. GTK_THEME, when
set, still wins.
---
 src/pcmanfm.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/pcmanfm.c b/src/pcmanfm.c
index 68c85d7..cf281bc 100644
--- a/src/pcmanfm.c
+++ b/src/pcmanfm.c
@@ -225,6 +225,7 @@ int main(int argc, char** argv)
     FmConfig* config;
     GError* err = NULL;
     SingleInstData inst;
+    const char* theme;
 #if FM_CHECK_VERSION(1, 2, 0)
     GList *l;
 #endif
@@ -279,6 +280,14 @@ int main(int argc, char** argv)
     g_signal_add_emission_hook(g_signal_lookup("columns-changed", GTK_TYPE_TREE_VIEW),
                                0, on_tree_view_columns_changed, NULL, NULL);
 
+    /* PCMANFM_GTK_THEME gives PCManFM a GTK theme of its own. Set as this
+     * process's theme setting rather than through GTK_THEME, it is not passed
+     * on to the applications and terminals PCManFM opens. GTK_THEME, when set,
+     * still wins. */
+    theme = g_getenv("PCMANFM_GTK_THEME");
+    if(theme && *theme)
+        g_object_set(gtk_settings_get_default(), "gtk-theme-name", theme, NULL);
+
     config = fm_app_config_new(); /* this automatically load libfm config file. */
 
     fm_gtk_init(config);
