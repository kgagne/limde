#!/bin/sh

set -eu

export LC_ALL=C

WPCTL=/usr/bin/wpctl
RUNTIME_DIR="/run/user/$(id -u)/tinybar"
STATE_FILE="$RUNTIME_DIR/volume"

mkdir -p "$RUNTIME_DIR"

case "${1:-}" in
    up)
        "$WPCTL" set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
        ;;

    down)
        "$WPCTL" set-volume @DEFAULT_AUDIO_SINK@ 5%-
        ;;

    mute)
        "$WPCTL" set-mute @DEFAULT_AUDIO_SINK@ toggle
        ;;

    sync)
        ;;

    mic-mute)
        # The default microphone, in its own file, so the overlay shows the
        # microphone and the speaker's state is left alone. Without a microphone
        # WirePlumber's default source can be an output's monitor, which wpctl
        # resolves to the output itself: leave that alone.
        "$WPCTL" inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null |
            grep -q 'media\.class = "Audio/Source' || exit 0
        "$WPCTL" set-mute @DEFAULT_AUDIO_SOURCE@ toggle
        output=$("$WPCTL" get-volume @DEFAULT_AUDIO_SOURCE@)
        printf '%s\nkey\n' "$output" > "$RUNTIME_DIR/microphone"
        exit 0
        ;;

    *)
        echo "usage: tinybar-volume {up|down|mute|mic-mute|sync}" >&2
        exit 2
        ;;
esac

output=$("$WPCTL" get-volume @DEFAULT_AUDIO_SINK@)

# A key's change ends with a "key" line, which makes Tinybar show the level
# overlay; sync and Tinybar's own reads leave it out.
if [ "$1" = sync ]; then
    printf '%s\n' "$output" > "$STATE_FILE"
else
    printf '%s\nkey\n' "$output" > "$STATE_FILE"
fi
