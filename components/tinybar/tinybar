#!/bin/sh
# Start Tinybar: the panel lives in share/elachisto/tinybar beside this bin/ directory.
export GSK_RENDERER=cairo
# No accessibility bus is installed by default; without this GTK logs a warning at start.
export GTK_A11Y=none
# gtk4-layer-shell must be loaded before GTK for the panel to sit at the screen edge.
export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0
here=$(dirname "$(readlink -f "$0")")
exec "$here/../share/elachisto/tinybar/tinybar.py" "$@"
