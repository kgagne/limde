#!/usr/bin/env bash
# Repository checks. Run before every commit (the pre-commit hook does this).
#   scripts/check            scrub gate + syntax checks on the tracked tree
#   scripts/check --clone    also clone the repository into a temp dir and check there
set -euo pipefail
root=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
cd "$root"
fail=0

# 1. Scrub gate: nothing personal or machine-specific in tracked files.
patterns=$(grep -vE '^\s*(#|$)' scripts/public-patterns)
mapfile -t files < <(git ls-files -co --exclude-standard \
  | grep -vxE 'scripts/public-(patterns|allow)|LICENSE|REUSE.toml' \
  | while IFS= read -r f; do [[ -f $f ]] && echo "$f"; done)
if ((${#files[@]})); then
  allow=$(grep -vE '^\s*(#|$)' scripts/public-allow)
  if hits=$(grep -nHiE -f <(printf '%s\n' "$patterns") -- "${files[@]}" 2>/dev/null \
      | grep -viE -f <(printf '%s\n' "$allow")); then
    echo "scrub: personal or machine-specific text found:" >&2
    printf '%s\n' "$hits" >&2
    fail=1
  fi
fi

# 2. Shell syntax for every bash/sh script.
while IFS= read -r f; do
  [[ -f $f ]] || continue
  head -n1 "$f" | grep -qE '^#!.*\b(ba)?sh\b' || continue
  bash -n "$f" || { echo "syntax: $f" >&2; fail=1; }
done < <(git ls-files -co --exclude-standard)

# 3. Icons: outlined/ must match its sources, and the icon theme must build.
if ! python3 - "$root/components/icons" <<'PY'
import hashlib, json, sys
from pathlib import Path
icons = Path(sys.argv[1])
record = json.loads((icons / 'outlined' / 'SOURCES.json').read_text())
sources = {str(p.relative_to(icons)) for d in ('src', 'brands') for p in (icons / d).rglob('*.svg')}
stale = [s for s in sorted(sources) if record.get(s) != hashlib.sha256((icons / s).read_bytes()).hexdigest()]
gone = sorted(set(record) - sources)
for s in stale: print(f'icons: {s} changed or is new; run tools/outline.py', file=sys.stderr)
for s in gone: print(f'icons: {s} was removed; run tools/outline.py', file=sys.stderr)
sys.exit(1 if stale or gone else 0)
PY
then fail=1; fi
tmp_theme=$(mktemp -d)
for mode in dark light; do
  python3 "$root/components/icons/build_theme.py" "$tmp_theme" --mode "$mode" \
    --appearance "$root/components/appearance/appearance.toml" >/dev/null \
    || { echo "icons: the $mode theme does not build" >&2; fail=1; }
done
rm -rf "$tmp_theme"

# 4. Colour contrast (WCAG 2.2) for both palettes.
python3 "$root/components/appearance/check-contrast" || fail=1

# 5. The code map still points at files and names that exist.
scripts/check-codemap || fail=1

# 6. Fresh-clone self-test: the same checks must pass on a clone (file modes, ignored files).
if [[ ${1:-} == --clone ]]; then
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  git clone -q --no-local . "$tmp/limde"
  "$tmp/limde/scripts/check" || fail=1
fi

((fail == 0)) && echo "check: ok"
exit "$fail"
