#!/usr/bin/env bash
# Headless QEMU test VMs for limde. No root needed; KVM access is enough.
#
#   tests/vm/vm base             install Ubuntu Server into the base image (unattended)
#   tests/vm/vm up NAME [--installed]   start a throwaway VM on a copy-on-write overlay
#                                of base, or of the saved installed image (limDE already
#                                installed; about a minute). LIMDE_VM_RES=1920x1200 offers
#                                a bigger screen
#   tests/vm/vm sync NAME [--no-restart]   copy this working tree into an installed VM, run
#                                ./install there (only what changed), then reboot so the
#                                session restarts with it
#   tests/vm/vm save NAME        save an installed VM as the installed image for `up
#                                --installed` (test-install --save does this after a pass)
#   tests/vm/vm ssh NAME [CMD]   run a command (or a shell) in it as `tester`
#   tests/vm/vm copy NAME SRC... DEST   rsync files into it (DEST is a guest path)
#   tests/vm/vm shot NAME FILE   save a PNG of its screen
#   tests/vm/vm click NAME X Y   left-click at screen pixel X,Y (virtual tablet)
#   tests/vm/vm down NAME        power it off (forced after 60 s)
#   tests/vm/vm rm NAME          delete its overlay
#   tests/vm/vm list             show VMs and whether they run
#   tests/vm/vm view NAME        watch and use its screen in a window (needs gvncviewer)
#   tests/vm/vm du               show the disk space the VMs use
#   tests/vm/vm clean [--all]    delete every VM and the base image (--all: also the ISO);
#                                `vm base` rebuilds from the recipe in this folder
#
# Everything lives in $LIMDE_VM_DIR (default: <repo>/local/vm, ignored by Git).
# The base image is for testing only: it has passwordless sudo for `tester` and
# autologin on tty1. limde itself never sets up either.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
dir=${LIMDE_VM_DIR:-$repo/local/vm}
iso_name=ubuntu-26.04.1-live-server-amd64.iso
iso_sha256=cc8a95cde20f6ced61a322420de00f10cc3c90ced545daa46cb9c1a117f1d927
iso_url=https://releases.ubuntu.com/26.04/$iso_name
ovmf_code=/usr/share/OVMF/OVMF_CODE_4M.fd
ovmf_vars=/usr/share/OVMF/OVMF_VARS_4M.fd
mem=${LIMDE_VM_MEM:-4096}
cpus=${LIMDE_VM_CPUS:-4}
# Screen size the guest is offered, WIDTHxHEIGHT (QEMU's default is 1280x800).
res=${LIMDE_VM_RES:-}
disk_size=20G
# The user-mode network's address for the host, as seen from the guest.
host_from_guest=10.0.2.2

die() { echo "vm: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing $1 (${2:-install it})"; }

name_ok() { [[ ${1:-} =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "VM name must be lowercase letters, digits, dashes"; }
vmdir() { echo "$dir/$1"; }
running() { [[ -S $(vmdir "$1")/qmp.sock ]] && "$here/qmp.py" "$(vmdir "$1")/qmp.sock" query-status >/dev/null 2>&1; }
port_of() { cat "$(vmdir "$1")/ssh-port"; }

ssh_opts() {
  echo -i "$dir/id_ed25519" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes -p "$(port_of "$1")"
}

qemu_common() {  # $1: disk, $2: vars file, $3: qmp socket
  echo -machine q35,accel=kvm -cpu host -m "$mem" -smp "$cpus" \
    -drive "if=pflash,format=raw,readonly=on,file=$ovmf_code" \
    -drive "if=pflash,format=raw,file=$2" \
    -drive "if=virtio,format=qcow2,file=$1" \
    -device "virtio-vga${res:+,xres=${res%x*},yres=${res#*x}}" -display none \
    -device virtio-tablet-pci \
    -qmp "unix:$3,server=on,wait=off"
}

free_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

# A free VNC display number (port 5900 + N) on the loopback interface.
free_vnc_display() {
  python3 - <<'PY'
import socket
for n in range(10, 100):
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", 5900 + n)); print(n); break
    except OSError:
        pass
    finally:
        s.close()
PY
}

cmd_base() {
  need qemu-system-x86_64 "sudo apt install qemu-system-x86"; need qemu-img; need curl
  [[ -r $ovmf_code ]] || die "missing $ovmf_code (sudo apt install ovmf)"
  mkdir -p "$dir"
  local iso=$dir/$iso_name
  if [[ ! -s $iso ]]; then
    echo "Downloading $iso_name"
    curl -fL --retry 3 -o "$iso.part" "$iso_url" && mv "$iso.part" "$iso"
  fi
  echo "$iso_sha256  $iso" | sha256sum -c --quiet - || die "$iso_name checksum mismatch"

  local work=$dir/base-build
  rm -rf "$work"; mkdir -p "$work/seed"
  "$here/iso-extract.py" "$iso" casper/vmlinuz "$work/vmlinuz"
  "$here/iso-extract.py" "$iso" casper/initrd "$work/initrd"

  [[ -f $dir/id_ed25519 ]] || ssh-keygen -q -t ed25519 -N '' -C limde-test -f "$dir/id_ed25519"
  local hash
  hash=$(openssl passwd -6 tester)
  sed -e "s|@PASSWORD_HASH@|$hash|" -e "s|@SSH_KEY@|$(cat "$dir/id_ed25519.pub")|" \
    "$here/autoinstall.yaml" > "$work/seed/user-data"
  echo "instance-id: limde-base" > "$work/seed/meta-data"
  : > "$work/seed/vendor-data"

  local port; port=$(free_port)
  python3 -m http.server --bind 127.0.0.1 --directory "$work/seed" "$port" \
    >"$work/seed-server.log" 2>&1 &
  seed_server=$!  # global: the EXIT trap runs after this function returns
  trap 'kill "$seed_server" 2>/dev/null || true' EXIT

  rm -f "$dir/base.qcow2" "$dir/base-vars.fd"
  qemu-img create -q -f qcow2 "$work/disk.qcow2" "$disk_size"
  cp "$ovmf_vars" "$work/vars.fd"
  echo "Installing Ubuntu Server into the base image (serial log: $work/serial.log)"
  # shellcheck disable=SC2046
  timeout 60m qemu-system-x86_64 $(qemu_common "$work/disk.qcow2" "$work/vars.fd" "$work/qmp.sock") \
    -drive "media=cdrom,readonly=on,file=$iso" \
    -kernel "$work/vmlinuz" -initrd "$work/initrd" \
    -append "autoinstall ds=nocloud;s=http://$host_from_guest:$port/ console=ttyS0,115200 ---" \
    -nic user,model=virtio-net-pci -serial "file:$work/serial.log" \
    || die "install did not finish (exit $?); see $work/serial.log"
  grep -q 'GET /user-data' "$work/seed-server.log" || die "the installer never fetched its answers"

  mv "$work/disk.qcow2" "$dir/base.qcow2"
  mv "$work/vars.fd" "$dir/base-vars.fd"
  chmod a-w "$dir/base.qcow2" "$dir/base-vars.fd"
  echo "Base image ready: $dir/base.qcow2"
}

cmd_up() {
  name_ok "${1:-}"; local d; d=$(vmdir "$1")
  local from=base
  [[ ${2:-} == --installed ]] && from=installed
  [[ -f $dir/base.qcow2 ]] || die "no base image; run: tests/vm/vm base"
  [[ $from == base || -f $dir/installed.qcow2 ]] \
    || die "no installed image; run tests/vm/test-install NAME --save first"
  running "$1" && { echo "$1 is already running (ssh port $(port_of "$1"))"; return; }
  mkdir -p "$d"
  if [[ ! -f $d/disk.qcow2 ]]; then
    # The installed image is a link to the newest save; build on that version, which
    # stays until no VM uses it, so a later save can run while this VM does.
    local image; image=$(basename "$(readlink -f "$dir/$from.qcow2")")
    qemu-img create -q -f qcow2 -F qcow2 -b "$dir/$image" "$d/disk.qcow2"
    cp "$dir/${image%.qcow2}-vars.fd" "$d/vars.fd" && chmod u+w "$d/vars.fd"
    echo "$image" > "$d/from"
  fi
  local port; port=$(free_port); echo "$port" > "$d/ssh-port"
  local vnc; vnc=$(free_vnc_display); echo "$vnc" > "$d/vnc-display"
  rm -f "$d/qmp.sock"
  # shellcheck disable=SC2046
  qemu-system-x86_64 $(qemu_common "$d/disk.qcow2" "$d/vars.fd" "$d/qmp.sock") \
    -nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$port-:22" \
    -vnc "127.0.0.1:$vnc" \
    -serial "file:$d/serial.log" -daemonize -pidfile "$d/qemu.pid"
  echo -n "Waiting for $1 to accept SSH on port $port "
  for _ in $(seq 120); do
    # shellcheck disable=SC2046
    if ssh $(ssh_opts "$1") tester@127.0.0.1 true 2>/dev/null; then echo " up"; return; fi
    echo -n .; sleep 2
  done
  die "$1 did not answer SSH within 4 minutes; see $d/serial.log"
}

cmd_ssh() {
  name_ok "${1:-}"; running "$1" || die "$1 is not running"
  local name=$1; shift
  # shellcheck disable=SC2046
  ssh $(ssh_opts "$name") ${1:+-T} tester@127.0.0.1 "$@"
}

cmd_copy() {
  name_ok "${1:-}"; running "$1" || die "$1 is not running"; (($# >= 3)) || die "usage: copy NAME SRC... DEST"
  local name=$1; shift; local dest=${!#}; set -- "${@:1:$#-1}"
  rsync -a --delete -e "ssh $(ssh_opts "$name")" "$@" "tester@127.0.0.1:$dest"
}

cmd_shot() {
  name_ok "${1:-}"; running "$1" || die "$1 is not running"; [[ -n ${2:-} ]] || die "usage: shot NAME FILE.png"
  local out; out=$(realpath -m "$2")
  "$here/qmp.py" "$(vmdir "$1")/qmp.sock" screendump "{\"filename\": \"$out\", \"format\": \"png\"}" >/dev/null
  echo "$out"
}

cmd_click() {  # absolute pointer, so a test can press a panel button by its position
  name_ok "${1:-}"; running "$1" || die "$1 is not running"
  [[ ${2:-} =~ ^[0-9]+$ && ${3:-} =~ ^[0-9]+$ ]] || die "usage: click NAME X Y (screen pixels)"
  local sock size w h; sock="$(vmdir "$1")/qmp.sock"
  size=${LIMDE_VM_RES:-1280x800}; w=${size%x*}; h=${size#*x}
  local x=$(( $2 * 32767 / (w - 1) )) y=$(( $3 * 32767 / (h - 1) ))
  "$here/qmp.py" "$sock" input-send-event "{\"events\": [{\"type\": \"abs\", \"data\": {\"axis\": \"x\", \"value\": $x}}, {\"type\": \"abs\", \"data\": {\"axis\": \"y\", \"value\": $y}}]}" >/dev/null
  sleep 0.1
  for down in true false; do
    "$here/qmp.py" "$sock" input-send-event "{\"events\": [{\"type\": \"btn\", \"data\": {\"button\": \"left\", \"down\": $down}}]}" >/dev/null
    sleep 0.05
  done
}

cmd_sync() {
  name_ok "${1:-}"; running "$1" || die "$1 is not running"
  local name=$1
  ssh_vm() { cmd_ssh "$name" "$@"; }
  cmd_copy "$name" --exclude=/local --exclude=.git "$repo/" limde/
  ssh_vm 'test -f /usr/local/share/limde/labwc.commit' \
    || die "limDE is not installed in $name; start it with: up $name --installed"
  ssh_vm 'cd limde && ./install --yes' | grep -E '^  (changed|failed)|change\(s\) made|No changes' || true
  [[ ${2:-} == --no-restart ]] && return
  # A reboot restarts the whole session the way a login does, so Tinybar and the rest
  # run inside it (NetworkManager and logind refuse a panel restarted over SSH).
  local boot; boot=$(ssh_vm 'cat /proc/sys/kernel/random/boot_id')
  ssh_vm 'sudo systemctl reboot' >/dev/null 2>&1 || true
  echo -n "Waiting for $name's session "
  for _ in $(seq 90); do
    sleep 2; echo -n .
    [[ $(ssh_vm 'cat /proc/sys/kernel/random/boot_id' 2>/dev/null) == "${boot:-x}" ]] && continue
    if ssh_vm 'pgrep -f "[s]hare/limde/tinybar/tinybar.py"' >/dev/null 2>&1; then echo " up"; return; fi
  done
  die "$name's session did not start Tinybar within 3 minutes"
}

cmd_save() {
  name_ok "${1:-}"; local d; d=$(vmdir "$1")
  [[ -f $d/disk.qcow2 ]] || die "no VM named $1"
  if running "$1"; then
    cmd_ssh "$1" 'test -f /usr/local/share/limde/labwc.commit' \
      || die "limDE is not installed in $1; nothing worth saving"
    cmd_down "$1" >/dev/null
  fi
  # A new version each time, flattened onto base so it needs no older one.
  local image; image=installed-$(date -u +%Y%m%d%H%M%S).qcow2
  qemu-img convert -q -O qcow2 -F qcow2 -B "$dir/base.qcow2" "$d/disk.qcow2" "$dir/$image.new"
  mv "$dir/$image.new" "$dir/$image"
  cp "$d/vars.fd" "$dir/${image%.qcow2}-vars.fd"
  chmod a-w "$dir/$image" "$dir/${image%.qcow2}-vars.fd"
  ln -sfn "$image" "$dir/installed.qcow2"
  ln -sfn "${image%.qcow2}-vars.fd" "$dir/installed-vars.fd"
  printf 'saved %s from VM %s; limDE %s\n' "$(date -u +%FT%TZ)" "$1" \
    "$(git -C "$repo" describe --always --dirty)" > "$dir/installed.info"
  echo "Installed image saved: $dir/$image ($(cat "$dir/installed.info"))"
  # Older versions go once no VM is built on them.
  local old
  for old in "$dir"/installed-*.qcow2; do
    [[ $(basename "$old") == "$image" ]] && continue
    grep -qxF "$(basename "$old")" "$dir"/*/from 2>/dev/null && continue
    rm -f "$old" "${old%.qcow2}-vars.fd"
  done
}

cmd_down() {
  name_ok "${1:-}"; running "$1" || { echo "$1 is not running"; return; }
  local d; d=$(vmdir "$1")
  "$here/qmp.py" "$d/qmp.sock" system_powerdown >/dev/null || true
  for _ in $(seq 60); do running "$1" || { echo "$1 stopped"; return; }; sleep 1; done
  "$here/qmp.py" "$d/qmp.sock" quit >/dev/null 2>&1 || true
  echo "$1 forced off"
}

cmd_rm() {
  name_ok "${1:-}"; running "$1" && die "$1 is running; stop it first"
  rm -rf "$(vmdir "$1")"; echo "$1 removed"
}

cmd_list() {
  [[ -f $dir/base.qcow2 ]] && echo "base: $dir/base.qcow2" || echo "base: not built"
  [[ -f $dir/installed.info ]] && echo "installed: $(cat "$dir/installed.info")" || echo "installed: none saved"
  local d
  for d in "$dir"/*/; do
    d=${d%/}; local n=${d##*/}
    [[ -f $d/disk.qcow2 ]] || continue
    if running "$n"; then echo "$n: running (ssh port $(port_of "$n"))"; else echo "$n: stopped"; fi
  done
}

cmd_view() {
  name_ok "${1:-}"; running "$1" || die "$1 is not running"
  need gvncviewer "sudo apt install --no-install-recommends gvncviewer"
  local vnc; vnc=$(cat "$(vmdir "$1")/vnc-display")
  setsid gvncviewer "127.0.0.1:$vnc" >/dev/null 2>&1 < /dev/null &
  echo "Opened $1's screen (VNC 127.0.0.1:$vnc, loopback only)"
}

cmd_du() {
  [[ -d $dir ]] || { echo "nothing yet ($dir)"; return; }
  du -sh "$dir"/* 2>/dev/null | sort -h | sed "s|$dir/||"
  echo "total: $(du -sh "$dir" | cut -f1) in $dir"
}

cmd_clean() {
  local n d
  for d in "$dir"/*/; do
    n=$(basename "$d"); [[ -f $d/disk.qcow2 ]] || continue
    running "$n" && cmd_down "$n"
  done
  for d in "$dir"/*/; do [[ -f $d/disk.qcow2 ]] && rm -rf "$d"; done
  rm -rf "$dir/base.qcow2" "$dir/base-vars.fd" "$dir/base-build" "$dir/results" \
    "$dir"/installed*
  if [[ ${1:-} == --all ]]; then
    rm -rf "$dir"
    echo "Removed everything in $dir. Rebuild with: tests/vm/vm base"
  else
    echo "Removed every VM and the base image; kept the ISO. Rebuild with: tests/vm/vm base"
  fi
}

sub=${1:-}; shift || true
case $sub in
  base|up|sync|save|ssh|copy|shot|click|down|rm|list|view|du|clean) "cmd_$sub" "$@" ;;
  *) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 2 ;;
esac
