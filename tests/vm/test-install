#!/usr/bin/env bash
# Acceptance test for the installer, in a fresh throwaway VM.
#   tests/vm/test-install [VM_NAME] [--distro arch] [--keep] [--save] [-- INSTALL_ARGS...]
# Ubuntu by default; --distro arch (or LIMDE_VM_DISTRO=arch) tests an Arch VM, with Arch's
# checks where the two differ (pacman, Arch's labwc or limDE's local build of it, PCManFM as
# a local package, PipeWire's user units, no AppArmor or unattended upgrades).
# 1. copy this working tree into the VM and run ./install --yes (plus INSTALL_ARGS);
#    networkd must be off right after it, before any reboot
# 2. run it again: it must report "No changes"
# 3. reboot: labwc must start on tty1 by itself, NetworkManager must be connected,
#    and networkd must stay off
# 4. limde-update: offer, install and go back from a test release on a local origin
# Saves logs and a screenshot under local/vm/results/<VM_NAME>/. Exit 0 = all passed.
# --save: when everything passed, save the VM as the installed image that
# `vm up NAME --installed` starts from (for fast iteration with `vm sync`).
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
vm=$here/vm
name=itest; keep=0; save=0; install_args=()
while (($#)); do
  case $1 in
    --keep) keep=1 ;;
    --save) save=1 ;;
    --distro) LIMDE_VM_DISTRO=${2:-}; shift ;;
    --distro=*) LIMDE_VM_DISTRO=${1#--distro=} ;;
    --) shift; install_args=("$@"); break ;;
    *) name=$1 ;;
  esac
  shift
done
distro=${LIMDE_VM_DISTRO:-ubuntu}
export LIMDE_VM_DISTRO=$distro
case $distro in
  ubuntu) mirror=archive.ubuntu.com ;;
  arch) mirror=archlinux.org ;;
  *) echo "test-install: unknown distro: $distro (ubuntu or arch)" >&2; exit 2 ;;
esac
out=$repo/local/vm/results/$name
rm -rf "$out"; mkdir -p "$out"
fails=0
pass() { echo "PASS  $*" | tee -a "$out/summary.txt"; }
fail() { echo "FAIL  $*" | tee -a "$out/summary.txt"; fails=$((fails + 1)); }
check() { local what=$1; shift; if "$@" >>"$out/checks.log" 2>&1; then pass "$what"; else fail "$what"; fi; }
on_vm() { "$vm" ssh "$name" "$@"; }

"$vm" down "$name" >/dev/null 2>&1 || true
"$vm" rm "$name" >/dev/null 2>&1 || true
"$vm" up "$name"
# With .git, so the install record and limde-update see a real clone.
"$vm" copy "$name" --exclude=/local "$repo/" limde/

echo "== first run"
on_vm "cd limde && ./install --yes ${install_args[*]}" >"$out/install-1.log" 2>&1; rc=$?
echo "exit code $rc" >>"$out/install-1.log"
if ((rc == 0)); then
  pass "first install run exits 0"
else
  fail "first install run exits 0 (see install-1.log)"
fi
# Before any reboot: turning networkd off must also stop its sockets, or the next
# connection to one (systemd-resolved's hook, at a name lookup) starts it again.
networkd_off='getent hosts '$mirror' >/dev/null; sleep 2
  ! systemctl -q is-active systemd-networkd.service &&
  [ -z "$(systemctl list-units --plain --no-legend --state=active "systemd-networkd*.socket")" ]'
check "networkd is off right after the install" on_vm "$networkd_off"
echo "== second run"
on_vm "cd limde && ./install --yes ${install_args[*]}" >"$out/install-2.log" 2>&1; rc=$?
echo "exit code $rc" >>"$out/install-2.log"
if ((rc == 0)); then
  pass "second install run exits 0"
else
  fail "second install run exits 0 (see install-2.log)"
fi
check "second run reports no changes" grep -q 'No changes' "$out/install-2.log"
check "plan shows the dependency total" grep -qE 'with their dependencies, [0-9]+ new' "$out/install-1.log"

echo "== reboot"
on_vm 'sudo systemctl reboot' >/dev/null 2>&1 || true
sleep 5
for _ in $(seq 60); do on_vm true 2>/dev/null && break; sleep 2; done
sleep 25   # let autologin start the session and its autostart pieces
check "labwc runs after reboot" on_vm 'pgrep -x labwc'
if [[ $distro == ubuntu ]]; then
check "running labwc is the limde build" on_vm 'pid=$(pgrep -x labwc) && [ "$(readlink /proc/$pid/exe)" = /usr/local/bin/labwc ] && grep -qx "$(. limde/pins/labwc; echo "$LABWC_COMMIT $WLROOTS_COMMIT")" /usr/local/share/limde/labwc.commit'
else
  # Arch's labwc package: Arch's own when it is 0.20.3 or newer, else limDE's build of the
  # pin as a local package of the same name (pkgrel 0.1). Either way rc.xml has the curves.
  check "running labwc is the labwc package" on_vm 'pid=$(pgrep -x labwc) && [ "$(readlink /proc/$pid/exe)" = /usr/bin/labwc ] && pacman -Qqo /usr/bin/labwc | grep -qx labwc'
  check "labwc is 0.20.3 or newer" on_vm '[ "$(printf "%s\n" 0.20.3 "$(pacman -Q labwc | sed "s/.* //; s/^[0-9]*://; s/-[^-]*$//")" | sort -V | head -1)" = 0.20.3 ]'
  if grep -q "building labwc .* as a local package" "$out/install-1.log"; then
    check "the local labwc package is the pinned release" on_vm '[ "$(pacman -Q labwc | sed "s/.* //")" = "$(. limde/pins/labwc; echo "$LABWC_TAG")-0.1" ]'
  fi
  check "rc.xml has the touchpad curves" on_vm 'grep -q "<accelProfile>custom</accelProfile>" /etc/xdg/labwc/rc.xml && grep -q "<scrollCurve " /etc/xdg/labwc/rc.xml'
  check "labwc's tested version is recorded" on_vm 'grep -qx "arch $(pacman -Q labwc | sed "s/.* //")" /usr/local/share/limde/labwc.commit'
fi
check "labwc runs on tty1" on_vm 'pid=$(pgrep -x labwc) && tty=$(ps -o tty= -p $pid) && [ "$tty" = tty1 ]'
check "tty1 login unlocks the keyring" on_vm 'grep -qx "auth  *optional  *pam_gnome_keyring.so" /etc/pam.d/login && grep -qx "session  *optional  *pam_gnome_keyring.so auto_start" /etc/pam.d/login'
[[ $distro == arch ]] && check "passwd changes the keyring's password too" on_vm 'grep -qxE "password[[:space:]]+optional[[:space:]]+pam_gnome_keyring.so" /etc/pam.d/passwd'
# OpenSSH's agent socket: Ubuntu's unit names it openssh_agent, Arch's ssh-agent.socket.
agent_sock=openssh_agent; [[ $distro == arch ]] && agent_sock=ssh-agent.socket
check "gcr-ssh-agent masked; SSH_AUTH_SOCK is OpenSSH's agent" on_vm 'for u in gcr-ssh-agent.socket gcr-ssh-agent.service; do [ "$(systemctl --user is-enabled $u)" = masked ] && ! systemctl --user -q is-active $u || exit 1; done; systemctl --user -q is-active ssh-agent.socket && systemctl --user show-environment | grep -qx "SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/'"$agent_sock"'"'
check "NetworkManager connected" on_vm 'nmcli -t -f STATE general | grep -q ^connected'
check "networkd stays off" on_vm "$networkd_off"
if [[ $distro == ubuntu ]]; then
check "built binaries have all their libraries" on_vm 'test -x /usr/local/bin/labwc -a -x /usr/local/libexec/limde/pcmanfm && ! ldd /usr/local/bin/labwc /usr/local/bin/labnag /usr/local/libexec/limde/pcmanfm | grep -q "not found"'
else
  check "built binaries have all their libraries" on_vm 'test -x /usr/local/libexec/limde/pcmanfm && ! ldd /usr/bin/labwc /usr/local/libexec/limde/pcmanfm | grep -q "not found"'
  check "PCManFM is the local package limde-pcmanfm" on_vm 'pacman -Qqo /usr/local/libexec/limde/pcmanfm | grep -qx limde-pcmanfm && pacman -Qqo /usr/local/share/limde/pcmanfm.build | grep -qx limde-pcmanfm'
  check "PipeWire's user units are on for every user" on_vm 'for u in pipewire.socket pipewire-pulse.socket wireplumber.service; do systemctl --global -q is-enabled $u || exit 1; done'
  case " ${install_args[*]} " in *printing*)
    check "printer names resolve through nss-mdns" on_vm 'grep -qE "^hosts:.* mdns_minimal \[NOTFOUND=return\] (resolve|dns)" /etc/nsswitch.conf && systemctl -q is-enabled cups.socket avahi-daemon.service' ;;
  esac
fi
check "pcmanfm on PATH runs the patched build" on_vm '[ "$(bash -lc "command -v pcmanfm")" = /usr/local/bin/pcmanfm ] && grep -q /usr/local/libexec/limde/pcmanfm /usr/local/bin/pcmanfm && grep -q preview_cmd /usr/local/libexec/limde/pcmanfm && grep -q PCMANFM_GTK_THEME /usr/local/libexec/limde/pcmanfm'
check "PCManFM appears once in the app menu" on_vm '[ "$(ls /usr/share/applications/pcmanfm.desktop /usr/local/share/applications/pcmanfm.desktop 2>/dev/null | wc -l)" = 1 ]'
check "walker and elephant have all their libraries" on_vm 'for f in /usr/local/bin/walker /usr/local/bin/elephant /usr/local/lib/elephant/{calc,desktopapplications,files,providerlist}.so; do [ -f "$f" ] || exit 1; done; ! ldd /usr/local/bin/walker /usr/local/bin/elephant /usr/local/lib/elephant/*.so 2>&1 | grep -q "not found"'
check "walker runs" on_vm '/usr/local/bin/walker --version'
check "fd is on PATH for the launcher's file search" on_vm 'command -v fd && fd --version'
check "xdg-open is there to open the launcher's results" on_vm 'command -v xdg-open'
check "elephant loads all four providers" on_vm 'out=$(timeout 20 /usr/local/bin/elephant listproviders 2>&1); for p in calc desktopapplications files providerlist; do echo "$out" | grep -qi "$p" || exit 1; done'
check "firefox has all its libraries" on_vm 'test -x ~/.local/opt/firefox/firefox && ! LD_LIBRARY_PATH=$HOME/.local/opt/firefox ldd ~/.local/opt/firefox/libxul.so ~/.local/opt/firefox/firefox-bin | grep -q "not found"'
[[ $distro == ubuntu ]] && check "firefox AppArmor profile loaded" on_vm 'sudo aa-status 2>/dev/null | grep -qx "   limde-firefox"'
check "firefox renders a page headless" on_vm 'rm -f /tmp/ff.png; timeout 90 ~/.local/opt/firefox/firefox --headless --screenshot /tmp/ff.png "data:text/html,<h1>limde</h1>" >/tmp/ff.log 2>&1; test -s /tmp/ff.png'
check "icon theme installed and resolves names" on_vm 'test -L /usr/local/share/icons/limde/24x24/icons/user-home.svg && test -f /usr/local/share/icons/limde/symbolic/icons/folder-symbolic.svg && test -f /usr/local/share/icons/limde/index.theme && test -f /usr/local/share/icons/limde-light/index.theme'
check "labwc merges config" on_vm 'tr "\0" " " < /proc/$(pgrep -x labwc)/cmdline | grep -q -- --merge-config'
check "title-bar buttons are where labwc looks" on_vm 'for b in close iconify max max_toggled; do test -f /usr/local/share/themes/limde/labwc/$b.xbm || exit 1; done; d=$(tr "\0" "\n" < /proc/$(pgrep -x labwc)/environ | sed -n "s/^XDG_DATA_DIRS=//p"); [ -z "$d" ] || case ":$d:" in *:/usr/local/share:*) ;; *) exit 1 ;; esac'
for proc in tinybar.py mako swayidle elephant 'walker --gapplication-service'; do
  check "session runs $proc" on_vm "pgrep -f '$proc' >/dev/null"
done
check "appearance rendered" on_vm 'test -f ~/.config/tinybar/style.css && limde-appearance --check'
check "redundant launcher entries hidden" on_vm 'for n in footclient foot-server pcmanfm-desktop-pref; do grep -q "^NoDisplay=true" /usr/local/share/applications/$n.desktop || exit 1; done'
check "agent-web window starts by itself" on_vm 'pgrep -f "[f]irefox --profile .*agent-web/profile --name limde.AgentWeb" >/dev/null'
check "agent-web opens the welcome page" on_vm 'grep -q "learning: not set up yet" ~/.local/state/limde/agent-web.log'
check "agent window mode defaults to web" on_vm '[ "$(limde-agent mode)" = web ] && [ ! -e ~/.config/limde/agent.conf ]'
check "agent-cli and limde-agent are installed" on_vm 'for f in /usr/local/bin/agent-cli /usr/local/bin/limde-agent; do test -x $f || exit 1; done; for f in tmux.conf foot.ini agent_cli_setup.py; do test -f /usr/local/share/limde/agent-cli/$f || exit 1; done; grep -qx "StartupWMClass=limde.AgentCLI" /usr/local/share/applications/limde.AgentCLI.desktop'
check "the session starts the agent through limde-agent" on_vm 'test -f /usr/local/share/limde/autostart.d/60-agent.sh && test ! -e /usr/local/share/limde/autostart.d/60-agent-web.sh'
check "close keys skip both agent windows" on_vm '[ "$(grep -c "<query identifier=\"limde.AgentWeb\" /><query identifier=\"limde.AgentCLI\" />" /etc/xdg/labwc/rc.xml)" = 3 ]'
check "the CLI agent window's font is installed" on_vm 'fc-list | grep -q "JetBrains Mono"'
check "no CLI agent window or service until it is chosen" on_vm '! pgrep -f "^foot --app-id=limde.AgentCLI" && ! systemctl --user -q is-active limde-agent-cli.service'
check "install record names this clone" on_vm 'grep -qx "source=$HOME/limde" /usr/local/share/limde/installed && grep -qx "commit=$(git -C limde rev-parse HEAD)" /usr/local/share/limde/installed'
check "limde-update is installed" on_vm 'limde-update --help | grep -q -- --check'
[[ $distro == ubuntu ]] && check "unattended security updates are on" on_vm 'systemctl -q is-enabled apt-daily-upgrade.timer && apt-config dump | grep -q "APT::Periodic::Unattended-Upgrade \"1\""'
check "no failed units" on_vm '[ -z "$(systemctl --failed --no-legend)" ]'
on_vm 'systemctl --failed --no-legend; cat ~/.local/state/limde/labwc.log' >"$out/after-reboot.log" 2>&1 || true

echo "== limde-update"
# A local origin with one new release tag on top of this commit; the clone's own origin
# is put back afterwards. Skipped when the copied tree has uncommitted changes.
if on_vm 'git -C limde diff --quiet HEAD' 2>/dev/null; then
  on_vm 'set -e; rm -rf /tmp/up; git clone -q --bare limde /tmp/up/origin.git
    git clone -q /tmp/up/origin.git /tmp/up/work; cd /tmp/up/work
    git -c user.name=t -c user.email=t@t commit -q --allow-empty -m "test release"
    git -c user.name=t -c user.email=t@t tag -a v99.0.0 -m "limDE v99.0.0 (test release)"
    git push -q origin HEAD:refs/heads/main v99.0.0
    git -C ~/limde remote get-url origin >/tmp/up/url 2>/dev/null || true
    git -C ~/limde remote remove origin 2>/dev/null || true
    git -C ~/limde remote add origin /tmp/up/origin.git' >"$out/update-setup.log" 2>&1
  before=$(on_vm 'git -C limde rev-parse HEAD')
  on_vm 'limde-update --check' >"$out/update-check.log" 2>&1
  check "limde-update --check offers the new release" grep -q 'Available: v99.0.0' "$out/update-check.log"
  on_vm 'limde-update --yes' >"$out/update.log" 2>&1
  check "limde-update installs the new release" on_vm 'grep -qx "commit=$(git -C limde rev-parse "v99.0.0^{commit}")" /usr/local/share/limde/installed'
  on_vm "limde-update --to $before --yes" >"$out/update-back.log" 2>&1
  check "limde-update --to goes back" on_vm "grep -qx commit=$before /usr/local/share/limde/installed && [ \"\$(git -C limde rev-parse HEAD)\" = $before ]"
  on_vm 'git -C ~/limde remote remove origin; url=$(cat /tmp/up/url); [ -z "$url" ] || git -C ~/limde remote add origin "$url"
    git -C ~/limde tag -d v99.0.0 >/dev/null; rm -rf /tmp/up' >>"$out/update-setup.log" 2>&1
else
  echo "  skipped: the copied tree has uncommitted changes"
fi
"$vm" shot "$name" "$out/screen.png" >/dev/null || fail "screenshot"

if ((save && fails == 0)); then
  "$vm" save "$name" || fail "saving the installed image"
elif ((save)); then
  echo "Not saved as the installed image: $fails check(s) failed"
fi
((keep)) || { "$vm" down "$name" >/dev/null; "$vm" rm "$name" >/dev/null; }
echo "== $(grep -c ^PASS "$out/summary.txt") passed, $fails failed; results in $out"
exit $((fails > 0))
